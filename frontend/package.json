{
  "name": "scientific-ragagent-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "tauri dev -- --locked",
    "desktop:check": "cd src-tauri && cargo check --locked",
    "desktop:test": "cd src-tauri && cargo test --locked",
    "desktop:build": "tauri build --no-bundle -- --locked",
    "desktop:bundle": "tauri build -- --locked",
    "test:transport": "node --experimental-strip-types tests/transport/transport.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
