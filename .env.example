# Local development defaults. Never use these DB defaults on a public deployment.
POSTGRES_PASSWORD=ragagent
DATABASE_URL=postgresql+psycopg://ragagent:ragagent@db:5432/ragagent
REDIS_URL=redis://redis:6379/0
AGENT_CONFIG=config/agents.yaml
# Keys are intentionally empty. Configure server-side runtime secrets only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SUPERVISOR_MODEL=gpt-4.1-mini-2025-04-14
RETRIEVER_MODEL=gpt-4.1-mini-2025-04-14
ANALYSIS_MODEL=gpt-4.1-mini-2025-04-14
REVIEWER_MODEL=gpt-4.1-mini-2025-04-14
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Recommended: a verified immutable Hugging Face commit SHA for local models.
# If empty/a tag, first model use resolves it to a SHA and freezes that adapter.
# A local model directory is identified by the hash of its artifacts instead.
# Hosted revision is only an operator label; it does not pin server weights.
EMBEDDING_REVISION=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY_ENV=
RERANKER_BACKEND=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_REVISION=
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CANDIDATE_TOP_N=30
EVIDENCE_TOP_K=8
RRF_K=60
MINIMUM_RERANK_SCORE=0.0
MAX_RETRIEVAL_RETRIES=2
MAX_REVISIONS=2
MAX_ITERATIONS=12
RAG_EVIDENCE_BUDGET=48
RESEARCH_EVIDENCE_BUDGET=96
# Per queued evaluation batch; ordinary workflow jobs retain their own timeout.
EVALUATION_TIMEOUT_SECONDS=7200
# Contextualization input only. UTF-8 byte budgeting is a conservative token estimate.
CONVERSATION_RECENT_MESSAGE_LIMIT=8
CONVERSATION_CONTEXT_TOKEN_BUDGET=8192
CONVERSATION_SUMMARY_MAX_BYTES=2048
CONVERSATION_MESSAGE_MAX_BYTES=2048
