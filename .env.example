# Local development defaults. Never use these DB defaults on a public deployment.
POSTGRES_PASSWORD=ragagent
DATABASE_URL=postgresql+psycopg://ragagent:ragagent@db:5432/ragagent
REDIS_URL=redis://redis:6379/0
AGENT_CONFIG=config/agents.yaml
# Keys are intentionally empty. Configure server-side runtime secrets only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SUPERVISOR_MODEL=gpt-4.1-mini
RETRIEVER_MODEL=gpt-4.1-mini
ANALYSIS_MODEL=gpt-4.1-mini
REVIEWER_MODEL=gpt-4.1-mini
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Optional immutable model revision and a compatible-service endpoint.
EMBEDDING_REVISION=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY_ENV=
RERANKER_BACKEND=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_REVISION=
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CANDIDATE_TOP_N=30
EVIDENCE_TOP_K=8
RRF_K=60
MINIMUM_RERANK_SCORE=0.0
MAX_RETRIEVAL_RETRIES=2
MAX_REVISIONS=2
MAX_ITERATIONS=12
RAG_EVIDENCE_BUDGET=48
RESEARCH_EVIDENCE_BUDGET=96
